{
  "name": "q-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Q-Tools — comprehensive web app with 85+ developer/utility tools (Vue 3 + Ionic + Fastify, PWA, iframe-embeddable).",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["bcrypt", "esbuild"],
    "overrides": {
      "@tiptap/core": "3.27.2",
      "@tiptap/pm": "3.27.2"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,md,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,json,md,yaml,yml}\" --ignore-path .gitignore",
    "clean": "pnpm -r --parallel exec rimraf dist node_modules/.cache"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
