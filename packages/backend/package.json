{
  "name": "@q-tools/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Q-Tools backend — Fastify + Mongoose + JWT API.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@q-tools/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "mongoose": "^9.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
