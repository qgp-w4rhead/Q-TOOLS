# Q-Tools backend environment variables.
# Copy this file to `.env` and adjust for your environment.
# In production, set these directly in the process environment — do NOT
# commit a real `.env` file.

# ---- Server ----
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/qtools

# ---- Auth (MUST be overridden in production) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- CORS (comma-separated origins, or * for any) ----
CORS_ORIGINS=*

# ---- Rate limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ---- Static SPA serving (production only) ----
# Path to the built frontend dist directory. Leave empty in dev (Vite
# serves the SPA on :5173 and proxies /api/* to this backend).
STATIC_ROOT=
